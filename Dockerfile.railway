FROM node:22-bookworm-slim AS build

ENV CI=true
WORKDIR /app

COPY package/ego-browser/package.json package/ego-browser/package-lock.json package/ego-browser/
COPY package/ego-linux-host/package.json package/ego-linux-host/package-lock.json package/ego-linux-host/
RUN npm ci --prefix package/ego-browser
RUN npm ci --prefix package/ego-linux-host

COPY package/ego-browser package/ego-browser
COPY package/ego-linux-host package/ego-linux-host
COPY skills skills

RUN npm run build --prefix package/ego-browser
RUN npm run build --prefix package/ego-linux-host
RUN npm prune --omit=dev --prefix package/ego-browser
RUN npm prune --omit=dev --prefix package/ego-linux-host

FROM node:22-bookworm-slim AS selkies-web-build

ENV CI=true \
    SELKIES_INJECT=1 \
    SELKIES_MODE=websockets \
    SELKIES_UPLOAD_DIR=/home/ego

WORKDIR /selkies-web-core
COPY third_party/selkies/web/selkies-web-core/package.json third_party/selkies/web/selkies-web-core/package-lock.json ./
RUN npm ci
COPY third_party/selkies/web/selkies-web-core ./
RUN npm run build

WORKDIR /selkies-dashboard
COPY third_party/selkies/web/selkies-dashboard/package.json third_party/selkies/web/selkies-dashboard/package-lock.json ./
RUN npm ci
COPY third_party/selkies/web/selkies-dashboard ./
COPY third_party/selkies/web/universal-touch-gamepad /universal-touch-gamepad
RUN cp /selkies-web-core/dist/selkies-core.js src/ \
    && npm run build \
    && mkdir -p /opt/selkies-web/src /opt/selkies-web/jsdb \
    && cp -a dist/. /opt/selkies-web/ \
    && cp /selkies-web-core/dist/selkies-core.js /opt/selkies-web/src/ \
    && cp -a /selkies-web-core/dist/jsdb/. /opt/selkies-web/jsdb/

COPY third_party/selkies/web/universal-touch-gamepad/universalTouchGamepad.js /opt/selkies-web/src/

FROM node:22-bookworm-slim AS selkies-wheelhouse

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      libxkbcommon-dev \
      python3-dev \
      python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /selkies-source
COPY third_party/selkies/README.md third_party/selkies/pyproject.toml ./
COPY third_party/selkies/src ./src
COPY --from=selkies-web-build /opt/selkies-web ./src/selkies/selkies_web
RUN sed -i -e 's|^version =.*|version = "0.0.0.dev0"|g' pyproject.toml
RUN python3 -m pip wheel --no-cache-dir \
      --wheel-dir /opt/selkies-wheels \
      /selkies-source

FROM node:22-bookworm-slim AS runtime

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      chromium \
      curl \
      dbus-x11 \
      fonts-liberation \
      fonts-noto-color-emoji \
      gosu \
      libdrm2 \
      libgl1 \
      libpulse0 \
      libx11-xcb1 \
      libxcb-dri3-0 \
      libxdamage1 \
      libxext6 \
      libxfixes3 \
      libxkbcommon0 \
      libxtst6 \
      openbox \
      pulseaudio \
      python3 \
      python3-pip \
      tini \
      wmctrl \
      x11-utils \
      x11-xkb-utils \
      x11-xserver-utils \
      xserver-xorg-core \
      xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ego \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/ego --shell /usr/sbin/nologin ego

COPY --from=selkies-wheelhouse /opt/selkies-wheels /tmp/selkies-wheels
RUN python3 -m pip install --break-system-packages --no-cache-dir --force-reinstall \
      --no-index --find-links=/tmp/selkies-wheels \
      selkies==0.0.0.dev0 \
    && rm -rf /tmp/selkies-wheels

WORKDIR /app
COPY --from=build /app/package/ego-browser package/ego-browser
COPY --from=build /app/package/ego-linux-host package/ego-linux-host
COPY --from=build /app/skills skills
COPY scripts/railway-entrypoint.sh /usr/local/bin/ego-railway-entrypoint
COPY scripts/railway-selkies-supervisor.sh /usr/local/bin/ego-railway-selkies-supervisor
COPY scripts/selkies-token-bootstrap.mjs /usr/local/libexec/ego-selkies-token-bootstrap.mjs
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/ego-lite/THIRD_PARTY_NOTICES.md

RUN chmod 0755 \
      /usr/local/bin/ego-railway-entrypoint \
      /usr/local/bin/ego-railway-selkies-supervisor \
    && chmod 0644 /usr/local/libexec/ego-selkies-token-bootstrap.mjs

ENV HOME=/home/ego \
    DISPLAY=:99 \
    EGO_BROWSER_AGENT_WORKSPACE=/app/skills/ego-browser \
    EGO_CHROME_PATH=/usr/bin/chromium \
    EGO_CHROME_NO_SANDBOX=1 \
    EGO_HEADLESS=0 \
    EGO_RUNTIME_DIR=/run/ego-lite \
    EGO_VISUAL_MODE=selkies \
    EGO_VIEWER_WIDTH=1920 \
    EGO_VIEWER_HEIGHT=1080 \
    EGO_INTERNAL_HEALTH_PORT=8082 \
    SELKIES_ADDR=0.0.0.0 \
    SELKIES_MODE=websockets \
    SELKIES_ENABLE_DUAL_MODE=false \
    SELKIES_ENABLE_HTTPS=false \
    SELKIES_ENABLE_RESIZE=false \
    SELKIES_IS_MANUAL_RESOLUTION_MODE=true \
    SELKIES_USE_CPU=true \
    SELKIES_COMMAND_ENABLED=false \
    SELKIES_FILE_TRANSFERS=none \
    SELKIES_MICROPHONE_ENABLED=false \
    SELKIES_GAMEPAD_ENABLED=false \
    SELKIES_ENABLE_SHARING=false \
    SELKIES_ENABLE_COLLAB=false \
    SELKIES_ENABLE_SHARED=false \
    SELKIES_FRAMERATE=60,15-60 \
    SELKIES_UI_TITLE="Ego Lite" \
    SELKIES_UI_SHOW_LOGO=false \
    PORT=8080

LABEL org.opencontainers.image.source="https://github.com/citrolabs/ego-lite" \
      org.opencontainers.image.description="Ego Lite Linux host with a Selkies visual-control surface" \
      org.opencontainers.image.licenses="MIT AND MPL-2.0" \
      org.opencontainers.image.selkies.source-revision="877cf202b4955d8477041c7831d4b34ebdb92d16"

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ego-railway-entrypoint"]
CMD ["node", "/app/package/ego-linux-host/bin/ego-linux-hostd.mjs", "run"]
